# --- App ---
ENVIRONMENT=development

# --- Postgres (local Docker defaults shown; swap for Supabase in production) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investor_intel
POSTGRES_SSLMODE=disable

# --- Qdrant (local Docker defaults; swap for Qdrant Cloud URL + API key in production) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_documents

# --- LLM provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

CHAT_MODEL=gemini-flash-latest
EXTRACTION_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=6

# --- Retention (keep only the newest N completed documents; older ones are deleted) ---
MAX_DOCUMENTS=10
